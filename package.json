{
  "name": "trucovale4",
  "displayName": "Truco Vale 4",
  "description": "Jugá al truco argentino desde la barra lateral de VS Code, contra la CPU u online: 1 vs 1 o en equipos de 4 y 6.",
  "version": "0.7.0",
  "icon": "images/icon.png",
  "publisher": "TrucoVale4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MateoDeMartino/Truco-Vale-4.git"
  },
  "homepage": "https://github.com/MateoDeMartino/Truco-Vale-4#readme",
  "bugs": {
    "url": "https://github.com/MateoDeMartino/Truco-Vale-4/issues"
  },
  "keywords": [
    "truco",
    "cartas",
    "juego",
    "argentina",
    "game"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "packageManager": "pnpm@10.16.1",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "test": "node esbuild.js && node dist/test/engine.test.js && node dist/test/team.test.js && node dist/test/room.test.js && node dist/test/sound.test.js && node dist/test/chat.test.js",
    "package": "pnpm run build && vsce package -o trucovale4-$npm_package_version.vsix"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.21.1",
      "https-proxy-agent": "^7.0.6",
      "http-proxy-agent": "^7.0.2"
    }
  },
  "activationEvents": [],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "trucovale4.view",
          "name": "Truco"
        }
      ]
    },
    "commands": [
      {
        "command": "trucovale4.newGame",
        "title": "Nuevo partido",
        "category": "Truco",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "trucovale4.newGame",
          "when": "view == trucovale4.view",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
